# Keep ML artifacts in git for fast cloud deployment
!ml/artifacts/*.pkl
!ml/artifacts/*.joblib
!ml/artifacts/*.faiss*
!ml/artifacts/*.npy
!ml/artifacts/*.jsonl
!ml/artifacts/.gitkeep
!ml/artifacts/*_metrics.json
!ml/artifacts/aggregates.json
!ml/artifacts/forecast.json
!ml/artifacts/graph.json
!ml/artifacts/patterns.json

# Generated processed data (regenerate via ml/pipeline/etl.py)
data/processed/*
!data/processed/.gitkeep
!data/processed/etl_summary.json

# Python
__pycache__/
*.pyc
*.egg-info/
.venv/
venv/

# Node / frontend
node_modules/
frontend/dist/
frontend/.vite/

# OS / editor
.DS_Store
*.log

# Environment variables — never commit real secrets
.env
.env.*
!.env.example

# Extra/scratch notes
extra/
